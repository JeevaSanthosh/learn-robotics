+// It is now a real <button> + popover element: tap, click, focus, or Escape.
 import glossary from '../../public/glossary.json';
 const { id } = Astro.props;
 const entry = glossary[id];
 const def = entry ? entry.def : 'Definition coming soon.';
 ---
-<span class="term" tabindex="0" data-def={def} aria-label={`${id}: ${def}`}><slot /></span>
+<button class="term" type="button" aria-expanded="false" data-term={id}>
+  <slot />
+  <span class="term-pop" hidden role="tooltip">{def}</span>
+</button>
+
+<script>
+  function closeAll(except) {
+    for (const t of document.querySelectorAll('.term[aria-expanded="true"]')) {
+      if (t === except) continue;
+      t.setAttribute('aria-expanded', 'false');
+      t.querySelector('.term-pop').hidden = true;
+      t.dispatchEvent(new CustomEvent('lr-close'));
+    }
+  }
+
+  for (const term of document.querySelectorAll('.term')) {
+    const pop = term.querySelector('.term-pop');
+    // "pinned" = opened by an explicit click/tap/Enter, so hovering away
+    // shouldn't dismiss it.
+    let pinned = false;
+
+    const show = (on) => {
+      closeAll(term);
+      term.setAttribute('aria-expanded', String(on));
+      pop.hidden = !on;
+      if (on) {
+        // flip the popover left if it would run off the right edge
+        pop.style.left = '0';
+        const box = pop.getBoundingClientRect();
+        if (box.right > window.innerWidth - 8) pop.style.left = `${window.innerWidth - 8 - box.right}px`;
+      }
+    };
+
+    // A pointer press fires focus BEFORE click. Toggling on `pop.hidden` here
+    // meant focus opened the tooltip and the click immediately closed it
+    // again — so tapping a term on a phone did nothing at all. Track intent
+    // explicitly instead of inferring it from current visibility.
+    term.addEventListener('click', () => {
+      pinned = !pinned;
+      show(pinned);
+    });
+
+    term.addEventListener('mouseenter', () => { if (!pinned) show(true); });
+    term.addEventListener('mouseleave', () => { if (!pinned) show(false); });
+    term.addEventListener('focus', () => { if (!pinned) show(true); });
+    term.addEventListener('blur', () => { pinned = false; show(false); });
+
+    term.addEventListener('lr-close', () => { pinned = false; });
+  }
+
+  document.addEventListener('keydown', (e) => {
+    if (e.key === 'Escape') closeAll(null);
+  });
+  document.addEventListener('click', (e) => {
+    if (!e.target.closest('.term')) closeAll(null);
+  });
+</script>
