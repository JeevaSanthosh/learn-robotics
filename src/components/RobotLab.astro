---
// The interactive heart of a lesson: block editor beside the simulator,
// a per-block help panel, and a toggleable "what this looks like as real
// code" bridge that highlights the line belonging to the selected block.
// Props:
//   lessonId  — slug used for progress tracking
//   goal      — 'blink:N' | 'reach-target' | 'near-wall' | 'free'
//   walls     — JSON string of extra wall rects for the arena
//   target    — JSON string {x,y,r} for reach-target goals
//   goalText  — human description shown above the Run button
const {
  lessonId,
  goal = 'free',
  walls = '[]',
  target = 'null',
  waypoints = '[]',
  line = '[]',
  start = 'null',
  goalText = '',
  blocks = 'all',
  required = '',
  maxBlocks = '',
  banned = '',
  predict = '',                 // '' | 'choice' | 'number' — predict-then-run (§7.1)
  predictPrompt = '',
  predictChoices = '[]',        // JSON: [{ label, rule }]  (rule like "bumped == false")
  predictMetric = '',           // for predict="number": which run metric to compare
  predictTolerance = '',        // for predict="number": ± tolerance
  world = '',                   // world id (src/content/worlds) for seeded grading (§8.6)
  seeds = '',                   // number of seeded variants to grade across (R2+)
  mustPass = '',                // how many seeds must pass (default 80%)
  unseen = '',                  // 'true' → grade on seeds the learner never watched (R4+)
  scoreBy = '',                 // scored metric name (R4+)
  fixedWorld = '',              // rigor honesty: this mission grades in one tuned arena
  textMode = '',                // enable the "edit as text" (MicroPython) handoff (§8.7, M6)
} = Astro.props;
---
<section
  class="robotlab card card-do bleed"
  data-lesson={lessonId}
  data-goal={goal}
  data-walls={walls}
  data-target={target}
  data-waypoints={waypoints}
  data-line={line}
  data-start={start}
  data-maxblocks={maxBlocks}
  data-banned={banned}
  data-blocks={blocks}
  data-required={required}
  data-goaltext={goalText}
  data-predict={predict}
  data-predict-prompt={predictPrompt}
  data-predict-choices={predictChoices}
  data-predict-metric={predictMetric}
  data-predict-tolerance={predictTolerance}
  data-world={world}
  data-seeds={seeds}
  data-mustpass={mustPass}
  data-unseen={unseen}
  data-scoreby={scoreBy}
>
  {goalText && <p class="goal"><span class="eyebrow">Your mission</span><br />{goalText}</p>}

  {predict && (
    <div class="predict" hidden>
      <p class="eyebrow">🔮 Predict first — then run</p>
      <p class="predict-prompt">{predictPrompt}</p>
      <div class="predict-choices"></div>
      <p class="predict-result" role="status" hidden></p>
    </div>
  )}

  <div class="lab-grid">
    <div class="editor-side">
      <div class="blockly-host" aria-label="Block editor"></div>
      {textMode && (
        <div class="text-host" hidden>
          <textarea class="text-editor" spellcheck="false" aria-label="MicroPython editor"></textarea>
          <p class="text-err" role="status"></p>
        </div>
      )}
      <div class="block-help" hidden>
        <p class="eyebrow bh-name"></p>
        <p class="bh-tip"></p>
        <pre class="bh-code"><code></code></pre>
      </div>
    </div>

    <div class="sim-side">
      <canvas width="360" height="300" aria-label="Robot simulator"></canvas>
      <div class="controls">
        <button class="btn run">▶ Run</button>
        <button class="btn btn-quiet reset">↺ Reset</button>
        <button class="btn btn-quiet btn-sm why" hidden>🔍 Why?</button>
      </div>
      <p class="status" role="status"></p>
      <div class="why-out" role="status" hidden></div>
      <div class="seeds" hidden>
        <p class="eyebrow">Graded across worlds — it has to work on all of them, not just the one you watched. Click a world to replay it.</p>
        <div class="seed-chips" role="list"></div>
      </div>
      <div class="review" hidden>
        <p class="eyebrow">Ways to make this better</p>
        <ul class="review-list"></ul>
      </div>
      <div class="controls secondary">
        <label class="autorun">
          <input type="checkbox" class="autorun-box" checked />
          Auto-run as I build
        </label>
        <button class="btn btn-quiet btn-sm code-toggle" aria-expanded="false">&lt;/&gt; Show real code</button>
        {textMode && <button class="btn btn-quiet btn-sm text-toggle" aria-pressed="false">⌨ Edit as text</button>}
        <button class="btn btn-quiet btn-sm share">🔗 Share</button>
        <button class="btn btn-quiet btn-sm expand" aria-pressed="false" title="Give the block editor the whole screen (Esc to exit)">⛶ Bigger editor</button>
      </div>
    </div>
  </div>

  <div class="code-bridge" hidden>
    <p class="eyebrow">The same program as real code — blocks and code are two spellings of one idea. Click a block to light up its line.</p>
    <div class="bridge-cols">
      <div class="bridge-col">
        <h3>Python (MicroPython-style) <button class="btn btn-quiet btn-sm copy" data-copy="py">Copy</button></h3>
        <pre class="py-out"><code></code></pre>
      </div>
      <div class="bridge-col">
        <h3>JavaScript (what the simulator runs) <button class="btn btn-quiet btn-sm copy" data-copy="js">Copy</button></h3>
        <pre class="js-out"><code></code></pre>
      </div>
    </div>
  </div>
</section>

<script>
  import { defineRobotBlocks, toolboxFor, Blockly, javascriptGenerator, pythonGenerator } from '../lib/blocks.js';
  import { BlockRunner } from '../lib/interpreter.js';
  import { RobotSim } from '../lib/sim.js';
  import { completeLesson, recordPrediction, recordConstraintSolve, recordMissionOutcome } from '../lib/progress.js';
  import { encodeProgram, decodeProgram } from '../lib/share.js';
  import { reviewProgram, explainRun } from '../lib/review.js';
  import { getWorld } from '../lib/worlds.js';
  import { grade } from '../lib/sim/grade.js';
  import { variant } from '../lib/sim/world.js';
  import { parse, PyError } from '../lib/pyparse.js';
  import { runPython, RuntimeError } from '../lib/pyrun.js';

  defineRobotBlocks();

  for (const root of document.querySelectorAll('.robotlab')) {
    const lessonId = root.dataset.lesson;
    const goal = root.dataset.goal;
    const walls = JSON.parse(root.dataset.walls || '[]');
    const target = JSON.parse(root.dataset.target || 'null');
    const waypoints = JSON.parse(root.dataset.waypoints || '[]');
    const line = JSON.parse(root.dataset.line || '[]');
    const startPose = JSON.parse(root.dataset.start || 'null');
    const maxBlocks = Number(root.dataset.maxblocks) || 0;
    const banned = (root.dataset.banned || '').split(',').map((s) => s.trim()).filter(Boolean);

    // Predict-then-run config (§7.1). Absent on non-graded / R1 labs.
    const predictKind = root.dataset.predict || '';
    const predictChoices = JSON.parse(root.dataset.predictChoices || '[]');
    const predictMetric = root.dataset.predictMetric || '';
    const predictTolerance = Number(root.dataset.predictTolerance) || 0;

    // Seeded multi-world grading config (§8.6). When a world + seeds are set,
    // the mission is graded across seeded variants and passes only if enough of
    // them pass — a hard-coded path that works in the arena you watched fails
    // the others.
    const worldId = root.dataset.world || '';
    const worldSpec = worldId ? getWorld(worldId) : null;
    const seedCount = Number(root.dataset.seeds) || 0;
    const seeded = !!(worldSpec && seedCount);
    const unseen = root.dataset.unseen === 'true';
    const mustPass = Number(root.dataset.mustpass) || (seedCount ? Math.ceil(seedCount * 0.8) : 0);
    const seedBase = unseen ? 900000 : 1000;
    const seedList = seeded ? Array.from({ length: seedCount }, (_, i) => seedBase + i) : [];

    // Arena the learner watches: for a seeded lab it's the first seed's variant;
    // otherwise the inline props (unchanged behaviour).
    const arenaFor = (seed) => {
      const w = variant(worldSpec, seed);
      return { walls: w.walls || [], target: w.target || null, waypoints: w.waypoints || [], line: w.line || [], start: w.start || null };
    };

    const ws = Blockly.inject(root.querySelector('.blockly-host'), {
      toolbox: toolboxFor(root.dataset.blocks),
      scrollbars: false,
      trashcan: true,
      renderer: 'zelos',
      zoom: { startScale: 0.85 },
    });

    const canvas = root.querySelector('canvas');
    // `let` so a seed-chip replay can rebuild the sim on a different world.
    let sim = new RobotSim(canvas, seeded ? arenaFor(seedList[0]) : { walls, target, waypoints, line, start: startPose });
    const status = root.querySelector('.status');
    const runBtn = root.querySelector('.run');
    const autoBox = root.querySelector('.autorun-box');

    // ---- predict-then-run (§7.1) ----------------------------------------
    // On a graded R2+ mission the learner commits a prediction before Run is
    // available. A wrong prediction never fails the mission — it is recorded as
    // the most informative outcome. The "truth" comes from the run itself,
    // matched against a small declarative rule (no eval — CSP stays intact).
    const predictEl = root.querySelector('.predict');
    let prediction = null;      // committed choice index, or committed number
    let predictScored = false;

    function gateRun() {
      const locked = !!predictKind && prediction === null;
      runBtn.disabled = locked;
      runBtn.title = locked ? 'Commit your prediction first' : '';
    }
    function commitPrediction(value, btn) {
      prediction = value;
      predictEl.querySelectorAll('button, input').forEach((el) => (el.disabled = true));
      btn?.classList.add('chosen');
      gateRun();
    }
    if (predictKind && predictEl) {
      predictEl.hidden = false;
      const host = predictEl.querySelector('.predict-choices');
      if (predictKind === 'choice') {
        predictChoices.forEach((c, i) => {
          const b = document.createElement('button');
          b.className = 'btn btn-sm btn-quiet predict-choice';
          b.textContent = c.label;
          b.addEventListener('click', () => commitPrediction(i, b));
          host.appendChild(b);
        });
      } else if (predictKind === 'number') {
        const input = document.createElement('input');
        input.type = 'number'; input.step = 'any'; input.className = 'predict-num';
        const b = document.createElement('button');
        b.className = 'btn btn-sm'; b.textContent = 'Lock in';
        b.addEventListener('click', () => { if (input.value !== '') commitPrediction(Number(input.value), b); });
        host.append(input, b);
      }
      gateRun();
    }

    // The run metrics a prediction rule / the explainer read.
    function runMetrics() {
      return {
        bumped: sim.bumped, reachedTarget: sim.reachedTarget, blinkCount: sim.blinkCount,
        lineAccuracy: sim.lineAccuracy, distanceFromStart: sim.distanceFromStart,
        distance: sim.readDistance(), visited: sim.visited.size,
      };
    }
    // A tiny, safe rule evaluator: "name OP value" only. No eval, no Function.
    function evalRule(rule, m) {
      const mt = String(rule).match(/^\s*(\w+)\s*(==|!=|>=|<=|>|<)\s*(true|false|-?\d+(?:\.\d+)?)\s*$/);
      if (!mt) return false;
      const [, key, op, raw] = mt;
      const actual = m[key];
      const val = raw === 'true' ? true : raw === 'false' ? false : Number(raw);
      switch (op) {
        case '==': return actual === val; case '!=': return actual !== val;
        case '>=': return actual >= val; case '<=': return actual <= val;
        case '>': return actual > val; case '<': return actual < val;
      }
      return false;
    }
    function scorePrediction() {
      if (!predictKind || prediction === null || predictScored) return;
      predictScored = true;
      const m = runMetrics();
      const resEl = predictEl.querySelector('.predict-result');
      let correct = false, actualText = '';
      if (predictKind === 'choice') {
        const actualIdx = predictChoices.findIndex((c) => evalRule(c.rule, m));
        correct = actualIdx === prediction;
        actualText = actualIdx >= 0 ? predictChoices[actualIdx].label : 'something else';
      } else {
        const actual = m[predictMetric];
        correct = Math.abs(actual - prediction) <= predictTolerance;
        actualText = typeof actual === 'number' ? actual.toFixed(2) : String(actual);
      }
      resEl.hidden = false;
      resEl.textContent = correct
        ? `✅ Your prediction matched — actually: ${actualText}.`
        : `🔎 Not what happened — actually: ${actualText}. A wrong prediction is the most useful kind; you just learned something you didn't know 30 seconds ago.`;
      recordPrediction(correct);
    }

    // ---- "Why did that happen?" — the rules-based run explainer (§8.8) ---
    const whyBtn = root.querySelector('.why');
    const whyOut = root.querySelector('.why-out');
    whyBtn?.addEventListener('click', () => {
      const ex = explainRun(sim.trace, {
        goal, bumped: sim.bumped, reachedTarget: sim.reachedTarget, target, lineAccuracy: sim.lineAccuracy,
      });
      if (!ex) { whyOut.hidden = true; return; }
      whyOut.hidden = false;
      whyOut.innerHTML = '';
      const s = document.createElement('strong');
      s.textContent = ex.title + '. ';
      whyOut.append(s, document.createTextNode(ex.detail));
    });

    // ---- load: shared link wins over the saved local workspace ----------
    const wsKey = `lr-ws-${lessonId}`;
    // Loading a workspace fires change events. Without this flag those events
    // wrote the freshly-loaded program straight over the learner's own saved
    // work — so merely OPENING a friend's share link destroyed your progress
    // on that lesson before you touched anything.
    let restoring = true;
    (async () => {
      try {
        const shared = await decodeProgram(location.hash);
        if (shared) {
          Blockly.serialization.workspaces.load(shared, ws);
          setStatus('Loaded a shared program — press ▶ Run to watch it.');
          return;
        }
        const saved = localStorage.getItem(wsKey);
        if (saved) Blockly.serialization.workspaces.load(JSON.parse(saved), ws);
      } catch {
      } finally {
        // let the load's own change events drain first
        setTimeout(() => { restoring = false; }, 0);
      }
    })();

    // ---- change handling: save, re-render bridge, maybe auto-run --------
    let autoTimer;
    ws.addChangeListener((e) => {
      if (e && e.isUiEvent) {
        if (e.type === Blockly.Events.SELECTED) paintBlockHelp();
        return;
      }
      if (!restoring) {
        try {
          localStorage.setItem(wsKey, JSON.stringify(Blockly.serialization.workspaces.save(ws)));
        } catch {}
      }
      renderBridge();
      paintBlockHelp();

      // MakeCode's best habit: the simulator reflects your program without
      // you having to ask. Debounced so dragging doesn't thrash it.
      if (autoBox.checked && !running) {
        clearTimeout(autoTimer);
        autoTimer = setTimeout(() => {
          if (ws.getTopBlocks(true).some((b) => b.getDescendants(false).length > 1)) execute(true);
        }, 900);
      }
    });

    // ---- per-block help (the VEXcode idea: help where your hand is) -----
    const help = root.querySelector('.block-help');
    const helpName = root.querySelector('.bh-name');
    const helpTip = root.querySelector('.bh-tip');
    const helpCode = root.querySelector('.bh-code code');

    function selectedBlock() {
      const sel = Blockly.getSelected?.() || Blockly.common?.getSelected?.();
      return sel && sel.workspace === ws ? sel : null;
    }

    function paintBlockHelp() {
      const b = selectedBlock();
      if (!b) { help.hidden = true; highlight(null); return; }
      help.hidden = false;
      helpName.textContent = readableName(b);
      helpTip.textContent = (typeof b.tooltip === 'function' ? b.tooltip() : b.tooltip) || 'Drag this into your program to use it.';
      const snippet = safeBlockCode(b);
      helpCode.textContent = snippet || '—';
      highlight(snippet);
    }

    function readableName(b) {
      const t = b.toString?.() || b.type;
      return t.length > 60 ? t.slice(0, 57) + '…' : t;
    }

    function safeBlockCode(b) {
      try {
        const out = javascriptGenerator.blockToCode(b);
        return (Array.isArray(out) ? out[0] : out || '').trim().split('\n')[0];
      } catch {
        return '';
      }
    }

    // ---- code bridge ----------------------------------------------------
    const bridge = root.querySelector('.code-bridge');
    const toggle = root.querySelector('.code-toggle');
    const pyOut = root.querySelector('.py-out code');
    const jsOut = root.querySelector('.js-out code');
    let lastJs = '';
    let lastPy = '';

    function renderBridge() {
      lastPy = 'import time\n\n' + (pythonGenerator.workspaceToCode(ws) || '# drag blocks to see code');
      lastJs = javascriptGenerator.workspaceToCode(ws) || '// drag blocks to see code';
      if (bridge.hidden) return;
      pyOut.textContent = lastPy;
      jsOut.textContent = lastJs;
    }

    // Light up the JS line that belongs to the selected block. Not a full
    // two-way editor, but it makes "blocks ARE code" visible rather than
    // asserted.
    function highlight(snippet) {
      if (bridge.hidden || !snippet) { jsOut.textContent = lastJs; return; }
      jsOut.textContent = '';
      for (const line of lastJs.split('\n')) {
        const el = document.createElement(line.includes(snippet) ? 'mark' : 'span');
        el.textContent = line + '\n';
        jsOut.appendChild(el);
      }
    }

    toggle.addEventListener('click', () => {
      bridge.hidden = !bridge.hidden;
      toggle.setAttribute('aria-expanded', String(!bridge.hidden));
      toggle.innerHTML = bridge.hidden ? '&lt;/&gt; Show real code' : '&lt;/&gt; Hide real code';
      renderBridge();
      paintBlockHelp();
    });

    for (const btn of root.querySelectorAll('.copy')) {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy === 'py' ? lastPy : lastJs);
          btn.textContent = 'Copied ✓';
          setTimeout(() => (btn.textContent = 'Copy'), 1500);
        } catch {
          btn.textContent = 'Select & copy';
        }
      });
    }

    // ---- share by link (no backend, no account, no cost) ----------------
    root.querySelector('.share').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      try {
        const hash = await encodeProgram(Blockly.serialization.workspaces.save(ws));
        const url = `${location.origin}${location.pathname}${hash}`;
        await navigator.clipboard.writeText(url);
        history.replaceState(null, '', hash);
        btn.textContent = '🔗 Link copied';
      } catch {
        btn.textContent = 'Could not copy';
      }
      setTimeout(() => (btn.textContent = '🔗 Share'), 1800);
    });

    // ---- running --------------------------------------------------------
    let running = false;
    let hasRun = false;

    function setStatus(text) {
      status.textContent = text;
    }

    // ---- text mode: the MicroPython handoff (§8.7, M6) ------------------
    // "Blocks were the training wheels." One-way by design — you sketch in
    // blocks, switch to text, and from there you're writing the real thing.
    const textHost = root.querySelector('.text-host');
    const textEditor = root.querySelector('.text-editor');
    const textErr = root.querySelector('.text-err');
    const textToggle = root.querySelector('.text-toggle');
    let textOn = false;

    textToggle?.addEventListener('click', () => {
      textOn = !textOn;
      if (textOn && !textEditor.value.trim()) textEditor.value = (lastPy || 'robot.move_forward(2)\n');
      textHost.hidden = !textOn;
      root.querySelector('.blockly-host').hidden = textOn;
      root.querySelector('.block-help').hidden = true;
      autoBox.parentElement.style.display = textOn ? 'none' : '';
      textToggle.setAttribute('aria-pressed', String(textOn));
      textToggle.textContent = textOn ? '🧩 Back to blocks' : '⌨ Edit as text';
      if (!textOn) requestAnimationFrame(() => Blockly.svgResize(ws));
    });

    function showTextError(e) {
      if (!textErr) return;
      textErr.textContent = (e instanceof PyError || e instanceof RuntimeError)
        ? `Line ${e.line}${e.col ? ':' + e.col : ''} — ${e.message}`
        : (e.message || String(e));
    }

    /** Drive the sim from whichever editor is active (blocks or text). */
    function runProgram(driver) {
      return textOn ? runPython(parse(textEditor.value), driver) : new BlockRunner(ws, driver).run();
    }

    async function execute(isAuto) {
      if (running) return;
      if (predictKind && prediction === null) {
        if (!isAuto) setStatus('🔮 Lock in your prediction first — then press Run.');
        return;
      }
      running = true;
      runBtn.disabled = true;
      root.classList.add('is-running');
      setStatus(isAuto ? 'Auto-running…' : 'Running…');
      if (textErr) textErr.textContent = '';
      sim.reset();
      try {
        await runProgram(sim);
        hasRun = true;
        scorePrediction();
        if (seeded) await runSeedGrade();
        else checkGoal();
        paintReview();
        if (whyBtn) whyBtn.hidden = false;
      } catch (err) {
        setStatus('🤔 ' + err.message);
        if (textOn) showTextError(err);
      } finally {
        running = false;
        runBtn.disabled = false;
        root.classList.remove('is-running');
      }
    }

    // ---- seeded multi-world grading + seed chips (§8.6) ------------------
    async function runSeedGrade() {
      // Blocks failing a required concept or a ban should still be caught before
      // celebrating, exactly as in the single-world path.
      const missing = textOn ? [] : missingRequired();
      if (missing.length) {
        setStatus('👀 It ran — but this mission is about ' + missing.map((t) => FRIENDLY[t] || t).join(' and ') + '. Use that, and it counts.');
        return;
      }
      if (!textOn && banned.length) {
        const usedTypes = new Set(ws.getAllBlocks(false).filter((b) => b.isEnabled()).map((b) => b.type));
        const hit = banned.filter((t) => usedTypes.has(t));
        if (hit.length) { setStatus('🚫 This challenge bans ' + hit.map((t) => FRIENDLY[t] || t).join(' and ') + '.'); return; }
      }

      setStatus(`Grading across ${seedCount} worlds…`);
      const runFn = (driver) => runProgram(driver);
      const result = await grade(runFn, worldSpec, { seeds: seedList, mustPass, goal, unseen });
      renderSeedChips(result.results);
      root.querySelector('.seeds').hidden = false;

      // "Don't crash" (survive) is passed by a robot that never moves; the
      // mission is to drive toward the wall and stop, so require real progress.
      if (result.passed && /^survive/.test(goal) && sim.distanceFromStart < 1) {
        setStatus('Your robot barely moved — the mission is to drive toward the wall and stop before you crash.');
        return;
      }
      if (result.passed) {
        setStatus(`🎉 Passed ${result.passedCount}/${seedCount} worlds — mission complete!`);
        if (maxBlocks || banned.length) recordConstraintSolve(lessonId);
        recordMissionOutcome({ tutorUsed: !!window.__lrTutorUsed });
        completeLesson(lessonId);
      } else {
        setStatus(`Passed ${result.passedCount}/${seedCount} — you need ${mustPass}. It works on some worlds but not all: that's the difference between a program and a robot. Click a red world to watch it fail.`);
      }
    }

    function renderSeedChips(results) {
      const host = root.querySelector('.seed-chips');
      host.innerHTML = '';
      results.forEach((r, i) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'seed-chip ' + (r.passed ? 'pass' : 'fail');
        chip.setAttribute('role', 'listitem');
        chip.textContent = `${r.passed ? '✓' : '✗'} ${i + 1}`;
        chip.title = r.passed ? `World ${i + 1}: passed` : `World ${i + 1}: ${r.failureReason || 'failed'} — click to replay`;
        chip.addEventListener('click', () => replaySeed(r.seed));
        host.appendChild(chip);
      });
    }

    async function replaySeed(seed) {
      if (running) return;
      running = true;
      runBtn.disabled = true;
      root.classList.add('is-running');
      setStatus('Replaying that world…');
      sim = new RobotSim(canvas, arenaFor(seed));
      try { await new BlockRunner(ws, sim).run(); paintReview(); }
      catch (err) { setStatus('🤔 ' + err.message); }
      finally { running = false; runBtn.disabled = false; root.classList.remove('is-running'); }
      if (whyBtn) whyBtn.hidden = false;
    }

    runBtn.addEventListener('click', () => execute(false));

    root.querySelector('.reset').addEventListener('click', () => {
      sim.stop();
      setTimeout(() => sim.reset(), 50);
      setStatus('');
      if (whyBtn) whyBtn.hidden = true;
      if (whyOut) whyOut.hidden = true;
    });

    // ---- goal verification: outcome + required concepts, no shortcuts ----
    const FRIENDLY = {
      robot_distance: 'the “distance to wall” sensor block',
      controls_repeat_ext: 'a repeat loop',
      controls_whileUntil: 'a repeat-while/until loop',
      controls_if: 'an if block',
      robot_start: 'the “when ▶ Run is pressed” event block',
      variables_set: 'a variable',
      robot_set_speed: 'the “set speed” block',
      robot_pen: 'the pen block',
      robot_line: 'the line sensor block',
      procedures_defnoreturn: 'a function you define yourself',
      procedures_callnoreturn: 'a call to your own function',
      math_arithmetic: 'a maths block',
    };

    function missingRequired() {
      const need = (root.dataset.required || '').split(',').map((s) => s.trim()).filter(Boolean);
      const usedTypes = new Set(ws.getAllBlocks(false).filter((b) => b.isEnabled()).map((b) => b.type));
      return need.filter((t) => !usedTypes.has(t));
    }

    function outcomeMet() {
      if (goal.startsWith('blink:')) {
        const n = Number(goal.split(':')[1]);
        return { done: sim.blinkCount >= n, hint: `LED blinked ${sim.blinkCount}/${n} times — keep going!` };
      }
      if (goal === 'reach-target')
        return {
          done: sim.reachedTarget,
          hint: 'Not on the target pad yet — trace the path with your finger, then match it with blocks.',
        };
      if (goal === 'visit-all') {
        const left = sim.waypoints.length - sim.visited.size;
        return {
          done: sim.allVisited && !sim.bumped,
          hint: sim.bumped
            ? '💥 Crashed. Every pad still has to be visited without hitting a wall.'
            : `${sim.visited.size}/${sim.waypoints.length} pads visited — ${left} to go. Plan the whole route before you build it.`,
        };
      }
      if (goal.startsWith('draw-')) {
        const want = Number(goal.split('-')[1]);
        const corners = sim.trailCorners();
        const closed = sim.distanceFromStart < 0.6;
        return {
          done: corners >= want - 1 && corners <= want + 1 && closed,
          hint: !sim.trail.length
            ? 'Nothing drawn yet — put the pen down before you start moving.'
            : !closed
              ? `Shape has ${corners} corners but does not finish where it started. A closed shape returns home.`
              : `Counted ${corners} corners, need about ${want}. Check your turn angle: for ${want} sides, each turn is ${Math.round(360 / want)}°.`,
        };
      }
      if (goal === 'follow-line') {
        const acc = sim.lineAccuracy;
        return {
          done: sim.reachedTarget && acc > 0.75,
          hint: !sim.reachedTarget
            ? `Did not reach the end pad. Line accuracy so far: ${Math.round(acc * 100)}%.`
            : `Reached the end, but only stayed on the line ${Math.round(acc * 100)}% of the time (need 75%). Check the line more often — shorter moves between checks.`,
        };
      }
      if (goal === 'near-wall')
        return {
          done: !sim.bumped && sim.readDistance() < 1.2,
          hint: sim.bumped
            ? '💥 The robot bumped the wall. It should stop itself BEFORE touching — let the sensor decide.'
            : 'The robot stopped too far away (or drove past). Get within about 1 square of the wall.',
        };
      return { done: false, hint: 'Program finished.' };
    }

    // --- program review: "how could I have done this better?" -----------
    const reviewBox = root.querySelector('.review');
    const reviewList = root.querySelector('.review-list');

    function paintReview() {
      if (textOn) { reviewBox.hidden = true; return; } // review reads blocks; text is on its own
      let items = [];
      try {
        items = reviewProgram(Blockly.serialization.workspaces.save(ws), {
          goal,
          par: Number(root.dataset.par) || 0,
          bumped: sim.bumped,
          reachedTarget: sim.reachedTarget,
          ran: hasRun,
        });
      } catch { items = []; }

      reviewBox.hidden = items.length === 0;
      reviewList.innerHTML = '';
      for (const s of items) {
        const li = document.createElement('li');
        li.className = `rev rev-${s.level}`;
        const strong = document.createElement('strong');
        strong.textContent = s.title;
        const span = document.createElement('span');
        span.textContent = ' — ' + s.detail;
        li.append(strong, span);
        reviewList.appendChild(li);
      }
    }

    function checkGoal() {
      if (goal === 'free') {
        setStatus('Program finished. Sandbox mode — experiment away!');
        return;
      }
      const outcome = outcomeMet();
      if (!outcome.done) { setStatus(outcome.hint); return; }
      if (!textOn && maxBlocks) {
        const used = ws.getAllBlocks(false).filter((b) => b.isEnabled() && b.type !== 'robot_start').length;
        if (used > maxBlocks) {
          setStatus(
            `👀 It works — but you used ${used} blocks and the budget is ${maxBlocks}. ` +
              'Find the repetition and factor it out. That constraint is the whole exercise.'
          );
          return;
        }
      }
      if (!textOn && banned.length) {
        const usedTypes = new Set(ws.getAllBlocks(false).filter((b) => b.isEnabled()).map((b) => b.type));
        const hitBanned = banned.filter((t) => usedTypes.has(t));
        if (hitBanned.length) {
          setStatus(
            '🚫 It works — but this challenge bans ' +
              hitBanned.map((t) => FRIENDLY[t] || t).join(' and ') +
              '. Solve it a different way; the restriction is the whole point.'
          );
          return;
        }
      }
      const missing = textOn ? [] : missingRequired();
      if (missing.length) {
        setStatus(
          '👀 The robot did it — but this mission is about ' +
            missing.map((t) => FRIENDLY[t] || t).join(' and ') +
            '. Rebuild your program using that, and it counts!'
        );
        return;
      }
      setStatus('🎉 Mission complete! Lesson marked done.');
      // Reasoning record: a constraint solved, and whether it needed the tutor.
      if (maxBlocks || banned.length) recordConstraintSolve(lessonId);
      recordMissionOutcome({ tutorUsed: !!window.__lrTutorUsed });
      completeLesson(lessonId);
    }

    // ---- "bigger editor" mode -------------------------------------------
    // A 360px-tall editor is fine for four blocks and hopeless once programs
    // grow past a screenful — which is exactly when functions and algorithms
    // arrive. This hands the lab the whole viewport, keeps the arena visible
    // beside it, and tells Blockly to remeasure.
    const expandBtn = root.querySelector('.expand');
    function setExpanded(on) {
      root.classList.toggle('expanded', on);
      document.body.classList.toggle('lab-expanded', on);
      expandBtn.setAttribute('aria-pressed', String(on));
      expandBtn.textContent = on ? '⤡ Exit big editor' : '⛶ Bigger editor';
      // Blockly measures its host on inject and never again unless told.
      requestAnimationFrame(() => Blockly.svgResize(ws));
    }
    expandBtn.addEventListener('click', () => setExpanded(!root.classList.contains('expanded')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('expanded')) setExpanded(false);
    });

    // ---- keep Blockly correct across layout changes ---------------------
    // The grid flips to two columns at 900px; Blockly measures its host once
    // at inject time and renders garbage after a resize unless told.
    const ro = new ResizeObserver(() => Blockly.svgResize(ws));
    ro.observe(root.querySelector('.blockly-host'));

    // ---- expose context to the AI tutor ---------------------------------
    // This is what lets "why doesn't my robot stop?" get a real answer.
    // Registered as a list rather than a single global so a lesson with two
    // labs reports the one the learner is actually looking at.
    const labs = (window.__lrLabs = window.__lrLabs || []);
    labs.push({
      el: root,
      read: () => ({
        code: javascriptGenerator.workspaceToCode(ws),
        blocks: ws.getAllBlocks(false).filter((b) => b.isEnabled()).map((b) => b.type),
        goal: root.dataset.goaltext || goal,
        status: status.textContent,
        ran: hasRun,
      }),
    });

    window.__lrLab = {
      getContext() {
        if (!labs.length) return null;
        // whichever lab is closest to the middle of the viewport
        const mid = window.innerHeight / 2;
        const best = labs
          .map((l) => {
            const r = l.el.getBoundingClientRect();
            return { l, d: Math.abs(r.top + r.height / 2 - mid) };
          })
          .sort((a, b) => a.d - b.d)[0];
        return best.l.read();
      },
    };

    renderBridge();
  }
</script>

