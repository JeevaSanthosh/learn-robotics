---
import Base from '../layouts/Base.astro';
import glossary from '../../public/glossary.json';
const entries = Object.entries(glossary).sort(([a], [b]) => a.localeCompare(b));
---
<Base title="Glossary">
  <h1>Glossary</h1>
  <p>Every term the course uses, in one plain sentence each. Type to filter.</p>
  <input id="filter" type="search" placeholder="Search terms…" aria-label="Search glossary" />
  <dl id="gloss">
    {entries.map(([term, { def }]) => (
      <div class="entry card" data-term={term}>
        <dt>{term}</dt>
        <dd>{def}</dd>
      </div>
    ))}
  </dl>
</Base>

<script>
  const filter = document.getElementById('filter');
  filter?.addEventListener('input', () => {
    const q = filter.value.toLowerCase();
    document.querySelectorAll('#gloss .entry').forEach((el) => {
      el.hidden = q !== '' && !el.dataset.term.includes(q) && !el.textContent.toLowerCase().includes(q);
    });
  });
</script>

<style>
  #filter { width: 100%; max-width: 24rem; padding: 0.55rem 0.7rem; border: 1.5px solid var(--ink-soft); border-radius: var(--radius); font-size: 1rem; font-family: var(--font-body); margin-bottom: 1.2rem; }
  .entry { margin-bottom: 0.8rem; }
  dt { font-family: var(--font-display); font-weight: 700; }
  dd { margin: 0.2rem 0 0; }
</style>
